#!/bin/sh
# push の前は**構文検査だけ**（2026-09-12・検査を雲へ-1 ③）。
#
#   ＊画面の実測（check.js ⑦⑯⑰⑱・adv-check・panel-check）は **GitHub Actions へ移した**。
#     VAIO は総物理メモリ 4GB で、headless の Edge を立てると検査そのものが重さでこける
#     （09-12 01:56 の FAIL がそれ。出直したら全部 PASS だった）。
#   ＊**VAIO で headless の Edge／Chrome は二度と立てない。**
#   ＊ここで見るのは、壊れた字を押し出さないための最低限——
#     本体の <script> と、リポジトリ直下の .js の構文。数秒で終わる。
#   ＊通らない版を押し出しても、雲側の検査が落ちれば **Pages の配信は止まる**（deploy は check の後段）。

cd "$(dirname "$0")/.." || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node が見つからないので構文検査を飛ばす" >&2
  exit 0
fi

node -e '
const fs = require("fs"), os = require("os"), path = require("path"), cp = require("child_process");
let bad = 0;
// 本体の <script> を切り出して node --check
const html = fs.readFileSync("koushu-handan.html", "utf8");
const blocks = [...html.matchAll(/<script>([\s\S]*?)<\/script>/g)];
blocks.forEach((m, i) => {
  const f = path.join(os.tmpdir(), "koushu-prepush-" + i + ".js");
  fs.writeFileSync(f, m[1]);
  const r = cp.spawnSync(process.execPath, ["--check", f], { encoding: "utf8" });
  if (r.status !== 0) { bad++; console.error("NG 本体の <script> #" + (i + 1) + "\n" + (r.stderr || "")); }
  try { fs.unlinkSync(f); } catch (e) {}
});
// リポジトリ直下の .js
//   ＊頭の階層に await があるもの（Scriptable の usage-widget-loader.js）は CommonJS では落ちる。
//     そのときだけ .mjs として見直す。両方で落ちたときだけ NG。
fs.readdirSync(".").filter(n => n.endsWith(".js")).forEach(n => {
  let r = cp.spawnSync(process.execPath, ["--check", n], { encoding: "utf8" });
  if (r.status !== 0) {
    const f = path.join(os.tmpdir(), "koushu-prepush-" + n + ".mjs");
    fs.writeFileSync(f, fs.readFileSync(n));
    const m = cp.spawnSync(process.execPath, ["--check", f], { encoding: "utf8" });
    try { fs.unlinkSync(f); } catch (e) {}
    if (m.status === 0) { console.log("  " + n + " … モジュールとして通った"); return; }
  }
  if (r.status !== 0) { bad++; console.error("NG " + n + "\n" + (r.stderr || "")); }
});
console.log("pre-push: 構文検査 … 本体の <script> " + blocks.length + "塊 ＋ 直下の .js。NG " + bad + "件");
process.exit(bad ? 1 : 0);
'
status=$?

if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-push: 構文が壊れているので push を止めた。直してから push すること。" >&2
  echo "          どうしても通したいときは git push --no-verify" >&2
fi

exit $status
